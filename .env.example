# Пример переменных окружения. На Render они задаются в Environment, настоящие значения в репозиторий не класть.
# Для запуска у себя скопируйте файл в .env (он не попадает в git) и заполните.
# ВАЖНО: локально используйте токен ОТДЕЛЬНОГО тестового бота от @BotFather. С боевым токеном
# main.py переставит вебхук на ваш компьютер, и бот на Render перестанет получать сообщения.

# Токен бота от @BotFather
BOT_TOKEN=
# Публичный адрес сервера, например https://имя.onrender.com (локально адрес ngrok)
PUBLIC_URL=
# Ваш числовой Telegram id: команды владельца и загрузка файлов
OWNER_ID=
# Любая строка, часть адреса вебхука
WEBHOOK_SECRET=
# Postgres (на проде Neon). Локально оставьте пустым: всё будет в schedule.db
DATABASE_URL=
# Необязательно: адрес мини-аппа, по умолчанию PUBLIC_URL
WEBAPP_URL=

# Та же строка, что в секрете репозитория CRON_SECRET (ежедневный вызов /cron из GitHub)
CRON_SECRET=

# Подгрузка с lms.sportedu.ru (только в Render, логин и пароль никому не пересылать)
LMS_LOGIN=
LMS_PASSWORD=
# Необязательные: 0 выключает плановую подгрузку
# LMS_SYNC_ENABLED=1
# LMS_SYNC_INTERVAL_HOURS=20
# LMS_TIMEOUT_SECONDS=30
# LMS_MAX_MINUTES=10
# LMS_BASE_URL=https://lms.sportedu.ru
